# --- Supabase Postgres -------------------------------------------------------
# Transaction pooler, port 6543. Used by the app at runtime (serverless).
DATABASE_URL=
# Session pooler or direct connection, port 5432. Used ONLY by drizzle-kit.
DIRECT_URL=

# --- Better Auth -------------------------------------------------------------
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Google OAuth ------------------------------------------------------------
# Redirect URI: <origin>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Sentry ------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Required by the Vercel build for source-map upload.
SENTRY_AUTH_TOKEN=

# --- Inngest ----------------------------------------------------------------
# Not needed for the local dev server; required in production.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Local dev only — set to 1 to use the Inngest dev server.
# NEVER set this in production; it disables signature verification.
# INNGEST_DEV=1

# --- Stripe -----------------------------------------------------------------
# Test-mode secret key (sk_test_...). Live mode is out of scope.
STRIPE_SECRET_KEY=
# From `stripe listen` locally; created in the dashboard for production.
# The two are DIFFERENT secrets.
STRIPE_WEBHOOK_SECRET=

# --- Anthropic (AI) ------------------------------------------------------
# Article generation uses Sonnet; onboarding extraction uses Haiku.
# Without this the app still builds and runs — website analysis reports
# "not configured" rather than failing the whole request.
ANTHROPIC_API_KEY=

# --- DataForSEO (keyword + SERP data) ------------------------------------
# Track rankings WEEKLY, not daily: at 1,500 keywords that is ~$3.60/mo
# instead of ~$27/mo, for data that barely differs.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- Platform administrators ----------------------------------------------
# Comma-separated emails allowed into /admin, which reads EVERY customer's
# data. Deliberately not a database column: a column is one bad UPDATE away
# from privilege escalation, so the source of truth lives outside the database
# and changing it requires a deploy. An empty value grants nobody access.
ADMIN_EMAILS=
