# --- Supabase Postgres -------------------------------------------------------
# Transaction pooler, port 6543. Used by the app at runtime (serverless).
DATABASE_URL=
# Session pooler or direct connection, port 5432. Used ONLY by drizzle-kit.
DIRECT_URL=

# --- Better Auth -------------------------------------------------------------
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Google OAuth ------------------------------------------------------------
# Two redirect URIs must be registered on the same client:
#   <origin>/api/auth/callback/google            (sign-in)
#   <origin>/api/integrations/google/callback    (Search Console + Analytics)
# Sign-in and analytics are separate consents on purpose: asking every new
# user to approve analytics scopes just to create an account costs signups.
# Enable in Google Cloud: Search Console API, Google Analytics Data API,
# Google Analytics Admin API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- RepGet's own Google Analytics (optional) --------------------------------
# Full setup, including the GA settings that must be changed: docs/site-analytics.md
#
# The tag. Public pages and sign-in only, and only after a visitor accepts the
# cookie banner. Unset = no banner and nothing loaded from Google. The web
# stream's Measurement ID (G-...). NEXT_PUBLIC_ is baked in at build time, so
# redeploy after changing it.
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
#
# The admin "Site analytics" page (/admin/analytics), which reads the
# property back. Not the customers' Google connection above.
# A Google Cloud SERVICE ACCOUNT reads the property: enable the Google
# Analytics Data API in the Cloud project, create a service account with a
# JSON key, and add its ...@...iam.gserviceaccount.com address as a Viewer in
# GA Admin > Property access management. Leave both unset and the admin page
# shows these setup steps instead. Server-only: never NEXT_PUBLIC_.
#   GA4_PROPERTY_ID          the property's NUMBER (Admin > Property details),
#                            not the G-... Measurement ID
#   GA4_SERVICE_ACCOUNT_KEY  the whole downloaded .json key file (or it in
#                            base64). A secret, like a password.
# GA4_PROPERTY_ID=123456789
# GA4_SERVICE_ACCOUNT_KEY={"type":"service_account","client_email":"...","private_key":"..."}
#
# Google Ads measurement (docs/site-analytics.md, "Google Ads").
# Consent Mode: "basic" (default) loads nothing from Google before Accept;
# "advanced" also loads the tags, cookieless, while a visitor has not
# answered yet. A Decline silences them in both. The privacy page follows it.
# NEXT_PUBLIC_CONSENT_MODE=basic
# Optional Google Tag Manager container (GTM-...), loaded BESIDE GA for
# Google Ads tags only. Never add a GA4 tag inside it: GA is sent by the site.
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# Measurement Protocol API secret (GA Admin > Data streams > the stream >
# Measurement Protocol API secrets). Lets the server report a subscription's
# first real payment as a "purchase". Server-only, a secret.
# GA4_API_SECRET=

# --- Sentry ------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Required by the Vercel build for source-map upload.
SENTRY_AUTH_TOKEN=

# --- Inngest ----------------------------------------------------------------
# Not needed for the local dev server; required in production.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Local dev only — set to 1 to use the Inngest dev server.
# NEVER set this in production; it disables signature verification.
# INNGEST_DEV=1

# --- Stripe -----------------------------------------------------------------
# Test-mode secret key (sk_test_...). Live mode is out of scope.
STRIPE_SECRET_KEY=
# From `stripe listen` locally; created in the dashboard for production.
# The two are DIFFERENT secrets.
STRIPE_WEBHOOK_SECRET=

# --- Partner program (cash affiliates, Stripe Connect) ----------------------
# docs/partner-program.md. Off by default: the database switches in
# Admin -> Affiliate partners start disabled, and LIVE transfers and bank
# payouts additionally need PARTNER_LIVE_PAYOUTS=enabled here. Test mode
# (an sk_test_ key) needs only the database switch.
# PARTNER_LIVE_PAYOUTS=
# Signing secret of the Stripe CONNECT endpoint (events on connected accounts:
# account.updated, payout.*) -> /api/stripe/connect-webhook. A different
# secret from STRIPE_WEBHOOK_SECRET.
# STRIPE_CONNECT_WEBHOOK_SECRET=
# Countries partners may be paid in (ISO, comma-separated). Default: US, CA,
# GB, CH and the EEA - narrow it to what your Connect settings allow.
# PARTNER_PAYOUT_COUNTRIES=
# Key for pseudonymous visitor hashes; falls back to BETTER_AUTH_SECRET.
# PARTNER_TRACKING_SECRET=

# --- Anthropic (AI) ------------------------------------------------------
# Article generation uses Sonnet; onboarding extraction uses Haiku.
# Without this the app still builds and runs — website analysis reports
# "not configured" rather than failing the whole request.
ANTHROPIC_API_KEY=

# --- DataForSEO (keyword + SERP data) ------------------------------------
# Track rankings WEEKLY, not daily: at 1,500 keywords that is ~$3.60/mo
# instead of ~$27/mo, for data that barely differs.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- Google indexing (SpeedyIndex) ----------------------------------------
# Every article that goes live is sent to Google's indexer, and the customer
# is told "Google indexed ..." (notifications + 7-day wins). Off while the key
# is empty. Key: en.speedyindex.com -> dashboard -> API. Pay per indexed URL
# (100 tokens, about $0.10 at the smallest package); unindexed URLs refunded.
# SPEEDYINDEX_DAILY_LIMIT caps URLs sent per 24 hours (default 100; 0 pauses
# sending). Balance and results: /admin -> "Google indexing".
SPEEDYINDEX_API_KEY=
SPEEDYINDEX_DAILY_LIMIT=

# --- Social media (bundle.social) ------------------------------------------
# Connects the customer's Reddit, X, Threads, Pinterest and Bluesky accounts
# and publishes their OWN posts (replies are always posted by the customer,
# with one click). Empty: accounts are usernames and own posts are one-click
# too. Key: bundle.social -> Organization -> API keys. The client pays the
# plan (Pro USD 100/month; the free plan allows 3 websites and 20 posts a
# month, enough to test) and X's per-post fees from bundle.social's prepaid
# balance. docs/social-media.md.
BUNDLE_SOCIAL_API_KEY=

# --- Platform administrators ----------------------------------------------
# Comma-separated emails allowed into /admin, which reads EVERY customer's
# data. Deliberately not a database column: a column is one bad UPDATE away
# from privilege escalation, so the source of truth lives outside the database
# and changing it requires a deploy. An empty value grants nobody access.
ADMIN_EMAILS=
# --- Credential encryption ------------------------------------------------
# Encrypts third-party credentials (Google refresh tokens, and WordPress
# application passwords on the publishing branch) at rest. These grant ongoing
# access to a customer's data, so a database leak must not expose them.
# Encrypts third-party credentials (WordPress application passwords) at rest.
# These grant WRITE access to a customer's live site, so a database leak
# without this key must not hand an attacker the ability to publish to them.
# openssl rand -base64 32
# Falls back to BETTER_AUTH_SECRET when unset, but a dedicated key is better:
# rotating auth sessions should not require re-encrypting every credential.
CREDENTIALS_ENCRYPTION_KEY=

# --- PayPal -----------------------------------------------------------------
# From developer.paypal.com -> Apps & Credentials. Sandbox and live are
# DIFFERENT credentials; live also needs a verified Business account.
# Without these the PayPal button is hidden entirely and card checkout is
# unaffected, so the app runs fine before they exist.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Created after deploying, by registering this URL in your PayPal app:
#   <origin>/api/paypal/webhook
PAYPAL_WEBHOOK_ID=
# "sandbox" (default) or "live", exactly. Defaulting to sandbox means a missing
# value can never accidentally take real money; any other value ("Live",
# "production") switches PayPal OFF and logs why. The PayPal button shows
# only when all four PayPal variables are set. Go-live steps:
# docs/paypal-go-live.md.
PAYPAL_ENV=sandbox
# "off" pauses NEW PayPal checkouts (the button, new subscriptions, plan
# changes) while existing PayPal subscribers keep being billed, recorded and
# cancelled: their webhooks keep working. Unset or anything else: PayPal on.
PAYPAL_CHECKOUT=

# --- Public site details -----------------------------------------------------
# Shown on the contact, privacy, terms and refunds pages. Those pages promise a
# contact address for data and refund requests, so this must be a real, MONITORED
# inbox. Unset, it is support@repget.com (lib/config/site.ts); `npm run doctor`
# treats a placeholder (@example.com) as a blocker.
NEXT_PUBLIC_SUPPORT_EMAIL=support@repget.com
# Trading name used in legal copy. Defaults to SEOVision.
NEXT_PUBLIC_COMPANY_NAME=SEOVision

# --- Article images (optional) -----------------------------------------------
# Anthropic does not generate images, so this needs a second vendor. Leave both
# unset and articles publish without a header image — everything else works.
# Set IMAGE_PROVIDER only when both keys are present, to say which one wins.
#   openai    — gpt-image-2. Billed per TOKEN, not per image ($30 per 1M output
#               tokens), so cost varies with size and quality. A few cents per
#               header image; the real figure is read from each response rather
#               than assumed, so usage tracking stays accurate.
#   replicate — flux-schnell, ~$0.003/image, much cheaper, less literal
# IMAGE_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# Model id, overridable so a newer one needs no code change. Defaults to
# gpt-image-2. Verify any value with `npm run check:images` before relying
# on it — a wrong id fails inside a background job at publish time.
# OPENAI_IMAGE_MODEL=gpt-image-2
# REPLICATE_API_TOKEN=r8_...

# --- Live chat (optional) ----------------------------------------------------
# Crisp website id, from Crisp → Settings → Website Settings → Setup
# instructions. A UUID. Leave unset and no chat widget loads at all.
# Loaded on the marketing site (anonymous) and inside the signed-in app
# (identified: email, name, workspace, plan). NEXT_PUBLIC_ is baked in at
# build time, so restart the dev server / redeploy after changing it.
# NEXT_PUBLIC_CRISP_WEBSITE_ID=00000000-0000-0000-0000-000000000000

# --- Image storage (optional) -------------------------------------------------
# Supabase Storage, for article images before they are published. Without it,
# articles are still written and published exactly as before — there is just
# nowhere to hold a picture in between, so replacing or uploading one is off.
#
# Create a PUBLIC bucket named "article-images" in the Supabase dashboard, then:
#   NEXT_PUBLIC_SUPABASE_URL   Project settings -> API -> Project URL
#   SUPABASE_SERVICE_ROLE_KEY  Project settings -> API -> service_role key
#
# The service role key bypasses row-level security. It is server-only and must
# never be exposed to the browser or committed.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend) -----------------------------------------------------------
# Transactional email: website invitations to people who do not have an account
# yet, and the notification sent when somebody who does is given access.
#
# Without these, inviting an existing user still works (access is granted and
# only the notification fails), but inviting a NEW address fails outright —
# the invitation token exists only in the email, so an unsent one can never be
# accepted. addWebsiteMember reports that rather than leaving a dead row.
#
#   RESEND_API_KEY   resend.com -> API Keys -> Create. "Sending access" is
#                    enough; this never reads anything back.
#   EMAIL_FROM       The sender. "onboarding@resend.dev" is Resend's shared
#                    address and needs no DNS at all, but it will ONLY deliver
#                    to the address the Resend account was opened with — fine
#                    for development, useless in production.
#
# BEFORE LAUNCH: verify a domain at resend.com/domains (SPF, DKIM and a DMARC
# record), then point EMAIL_FROM at it. Gmail and Yahoo reject bulk mail with
# no DMARC, so an unverified sender means invitations land in spam and get
# reported as "invites don't work".
# RESEND_API_KEY=re_...
# EMAIL_FROM=RepGet <noreply@send.repget.com>
# Content Security Policy (src/lib/security-headers.ts): ENFORCED by default.
# Leave CSP_MODE unset (or "enforce") everywhere. "report-only" is a temporary
# rollback switch only; any other value fails the build. The mode is fixed at
# BUILD time and the proxy follows the build, so changing it needs a rebuild
# (on Vercel, a redeploy). Dynamic app/auth pages get a per-request nonce;
# cached public pages keep 'unsafe-inline' scripts (see docs/security-day-1.md).
# The policy allows only the integrations configured above/below
# (NEXT_PUBLIC_CRISP_WEBSITE_ID, NEXT_PUBLIC_GA4_MEASUREMENT_ID,
# NEXT_PUBLIC_GTM_ID, NEXT_PUBLIC_SENTRY_DSN).
# CSP_MODE=enforce

# Visitor addresses for the limits on the free tools, the public audit and
# "Get Featured" requests (src/lib/visitor-key.ts). On Vercel nothing is
# needed: its edge overwrites x-real-ip / x-forwarded-for. Anywhere else, set
# this ONLY to a header your own proxy overwrites on every request (for
# example cf-connecting-ip behind Cloudflare with the origin locked to it).
# Unset off Vercel = every visitor shares one bucket (fails closed).
# TRUSTED_CLIENT_IP_HEADER=x-real-ip

# Read-only database security check (npm run check:db-security). Never read
# from this file automatically; pass it on the command line for one run.
# CHECK_DATABASE_URL=postgres://<read-only role>:<password>@<host>:5432/postgres

# Article research: off (default), pilot (human review on every article), on
# (review on incomplete research or flagged evidence). Migrate before enabling.
ARTICLE_RESEARCH_MODE=off
# Required scope: comma-separated website UUIDs. Empty disables research.
# Set exactly "*" only for an intentional all-website rollout.
ARTICLE_RESEARCH_WEBSITE_IDS=
# Optional Anthropic model experiments by task. Any override holds new drafts
# for human review; it never changes GEO, keyword research, or the public blog.
ARTICLE_MODEL_RESEARCH_PLAN=
ARTICLE_MODEL_SOURCE_SELECTION=
ARTICLE_MODEL_RESEARCH=
ARTICLE_MODEL_OUTLINE=
ARTICLE_MODEL_BODY=
ARTICLE_MODEL_EVIDENCE_CHECK=
ARTICLE_MODEL_EVIDENCE_CORRECTION=
ARTICLE_MODEL_IMAGE_SCENE=
ARTICLE_MODEL_BODY_SCENES=
