diff --git a/src/lib/publishing/rollback-gate.ts b/src/lib/publishing/rollback-gate.ts
new file mode 100644
index 0000000..0dfdd55
--- /dev/null
+++ b/src/lib/publishing/rollback-gate.ts
@@ -0,0 +1,76 @@
+import { sql, type SQL } from "drizzle-orm";
+
+import { db } from "@/lib/db";
+
+/**
+ * ROLLBACK COMPATIBILITY for the release before the managed Partner Network.
+ *
+ * This release knows nothing of the review gate or the dispatch boundary, but
+ * the database it may be rolled back onto does (migrations 0043-0045):
+ * articles held for the RepGet team's review, approvals tied to an exact
+ * revision, the operator's publication freeze, and deliveries whose outcome
+ * is not known yet. Without this file, rolling back would publish every held
+ * article on the next scheduled release, and create a second post for a send
+ * whose answer was lost.
+ *
+ * Requires migrations 0043 and 0044 (0045 is optional) - applied on any
+ * database the newer build has run against.
+ *
+ * DELIBERATELY STRICTER THAN THE NEWER BUILD. This build has no row lock
+ * between its check and its send, so it cannot keep an edit from riding out
+ * on an approval the edit invalidated, and it cannot reconcile an unanswered
+ * send. So it sends only what the release before always sent, and holds:
+ *
+ *   - EVERY article under the managed review (review_status set) - pending
+ *     AND approved. Approved articles wait for the newer build;
+ *   - every article with a delivery whose outcome is unknown: in flight (of
+ *     any age - a lease running out is not completion), uncertain (a create
+ *     whose answer was lost: sending again could duplicate the post), or an
+ *     unacknowledged plugin hand-over (expired, "abandoned" before 0045);
+ *   - everything while platform_controls.publication_freeze is enabled.
+ *
+ * What this build cannot do: approve, reopen, place links, or resolve an
+ * unknown outcome. Those wait for the newer build. Nothing is approved or
+ * resolved in bulk to make a rollback convenient.
+ */
+
+const FROZEN = sql.raw(
+  `exists (select 1 from platform_controls pc where pc.key = 'publication_freeze' and pc.enabled)`,
+);
+
+const UNRESOLVED = sql.raw(`exists (
+  select 1 from publication_dispatches pd
+  where pd.article_id = "articles"."id"
+    and pd.status in ('in_flight', 'uncertain', 'expired', 'abandoned')
+)`);
+
+/** For queries that pick articles to send. `articles` must be in scope. */
+export const rollbackReleasableSql: SQL = sql`(
+  "articles"."review_status" is null
+  and not ${FROZEN}
+  and not ${UNRESOLVED}
+)`;
+
+/**
+ * Why this article may not be sent now, or null. For the Publish press and
+ * the publish job, which address one article.
+ */
+export async function rollbackHold(articleId: string): Promise<string | null> {
+  const result = await db.execute(sql`
+    select ${FROZEN} as frozen,
+           "articles"."review_status" as review_status,
+           ${UNRESOLVED} as unresolved
+    from articles where "articles"."id" = ${articleId}
+  `);
+  const rows = (Array.isArray(result) ? result : (result as { rows: unknown[] }).rows) as unknown[];
+  const row = rows[0] as { frozen: boolean; review_status: string | null; unresolved: boolean } | undefined;
+  if (!row) return null;
+  if (row.frozen) return "Publishing is paused by the RepGet team.";
+  if (row.unresolved) {
+    return "An earlier delivery of this article has not been confirmed yet. It waits until the RepGet team resolves it.";
+  }
+  if (row.review_status !== null) {
+    return "This article is being prepared by the RepGet team for the Partner Network. It goes out once the full release is back.";
+  }
+  return null;
+}
